# ================= PATTERN DETECTION (BULLISH ONLY) =================
def check_pattern_on_candle(candle):
    """
    BULLISH FLYING CANDLE:
      - GREEN candle (close > open)
      - Entirely BELOW EMA5, i.e. high < EMA5 (high not touching EMA5)
      - Applies only to the LAST COMPLETED candle
    EMA5 is computed from candles BEFORE the alert candle (no look-ahead).
    """
    global alert_candle, alert_candle_timeframe, completed_candles

    # Need at least 10 prior candles for a stable EMA5
    if len(completed_candles) < 11:
        return False

    # Candles BEFORE the one being checked (the alert candle is the last
    # element we just appended).
    prior_closes = [c["close"] for c in list(completed_candles)[:-1]]
    if len(prior_closes) < 10:
        return False

    ema_5 = pd.Series(prior_closes).ewm(span=5, adjust=False).mean().iloc[-1]

    # BULLISH pattern: green candle, high strictly below EMA5
    if candle["close"] > candle["open"] and candle["high"] < ema_5:
        # Don't overwrite an active, un-broken alert
        if alert_candle is not None and not position_taken:
            print("\nℹ️  Active alert exists; ignoring new alert candle.")
            return False

        alert_candle = {
            "type": "BULLISH",
            "timestamp": candle["timestamp"],
            "open": candle["open"],
            "high": candle["high"],
            "low": candle["low"],
            "close": candle["close"],
            "ema_5": ema_5,
        }
        alert_candle_timeframe = candle["timestamp"]

        print("\n\n🟢 BULLISH FLYING CANDLE DETECTED!")
        print(f"   Time:     {candle['timestamp'].strftime('%Y-%m-%d %H:%M:%S')}")
        print(f"   Green:    O={candle['open']:.2f}  C={candle['close']:.2f}")
        print(f"   High={candle['high']:.2f}  Low={candle['low']:.2f}")
        print(f"   EMA5:     {ema_5:.2f}  (gap = {ema_5 - candle['high']:.2f})")
        print(f"   ⏰ Waiting for NEXT candle to break above {candle['high']:.2f}")
        print(f"   🛑 SL will be alert LOW = {candle['low']:.2f}")
        return True

    return False


# ================= ENTRY LOGIC =================
def monitor_entry_on_price(current_price, current_time, current_timeframe):
    """
    Enter LONG when:
      - a valid bullish alert exists,
      - we are on a candle STRICTLY AFTER the alert candle,
      - current price > alert candle HIGH,
      - no position already taken.
    """
    global alert_candle, alert_candle_timeframe, position_taken
    global current_position, entry_price, breakout_triggered

    if alert_candle is None or position_taken or breakout_triggered:
        return False

    # Must be on the NEXT candle (or later) — not the alert candle itself
    if alert_candle_timeframe is None or current_timeframe <= alert_candle_timeframe:
        return False

    if current_price > alert_candle["high"]:
        entry_price = alert_candle["high"]
        sl_price = alert_candle["low"]                     # SL = alert candle LOW
        risk_points = entry_price - sl_price
        if risk_points <= 0:
            print("⚠️  Invalid SL (risk<=0); skipping trade.")
            return False
        target_price = entry_price + RR_RATIO * risk_points  # R:R = 1:3

        current_position = "LONG"
        position_taken = True
        breakout_triggered = True

        print("\n🎯 BREAKOUT — LONG ENTRY")
        print(f"   Alert High (entry): {entry_price:.2f}")
        print(f"   Current Price:      {current_price:.2f}")
        print(f"   SL (alert LOW):     {sl_price:.2f}  (risk = {risk_points:.2f})")
        print(f"   Target (3R):        {target_price:.2f}  (reward = {RR_RATIO*risk_points:.2f})")
        print(f"   Risk:Reward = 1:{RR_RATIO:g}")

        create_and_execute_trade("LONG", entry_price, sl_price, target_price)
        return True

    return False


