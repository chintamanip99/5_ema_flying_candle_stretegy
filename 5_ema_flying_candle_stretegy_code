def onmessage(message):
    """WebSocket message received callback"""
    global completed_candles, current_candle, last_complete_timeframe, alert_candle, position_taken, current_position, entry_price, breakout_triggered
    
    try:
        if isinstance(message, dict):
            msg_type = message.get("type")
            
            # Handle subscription confirmation
            if msg_type == "sub":
                if message.get("s") == "ok":
                    print(f"✅ Subscription confirmed")
                else:
                    print(f"❌ Subscription failed: {message.get('message')}")
                return
            
            # Handle live market data
            elif msg_type == "sf" or "ltp" in message:
                symbol = message.get("symbol", INSTRUMENT_KEY)
                ltp = message.get("ltp", 0)
                
                if ltp == 0:
                    return
                
                current_price = float(ltp)
                current_time = datetime.datetime.now()
                
                # Calculate current timeframe (1-minute interval)
                current_timeframe = current_time.replace(second=0, microsecond=0)
                
                # Check if we've moved to a new timeframe
                if last_complete_timeframe is None or current_timeframe != last_complete_timeframe:
                    # Reset breakout trigger for new candle
                    breakout_triggered = False
                    
                    # The previous timeframe is complete, process it
                    if current_candle is not None:
                        # Add the completed candle to history
                        completed_candle = {
                            'timestamp': current_candle['timestamp'],
                            'open': current_candle['open'],
                            'high': current_candle['high'],
                            'low': current_candle['low'],
                            'close': current_candle['close'],
                            'volume': current_candle['volume']
                        }
                        completed_candles.append(completed_candle)
                        
                        print(f"\n📊 {TIMEFRAME}-minute Candle completed: {completed_candle['timestamp'].strftime('%H:%M:%S')} | H:{completed_candle['high']:.2f} L:{completed_candle['low']:.2f} C:{completed_candle['close']:.2f}")
                        
                        # STEP 1: Check if this completed candle forms a BULLISH pattern (FLYING CANDLE)
                        check_pattern_on_candle(completed_candle)
                        
                        # STEP 2: Check exit conditions for active trades using this completed candle
                        if active_trades:
                            monitor_exit_conditions(current_price, current_time, completed_candle)
                    
                    # Start new candle
                    current_candle = {
                        'timestamp': current_timeframe,
                        'open': current_price,
                        'high': current_price,
                        'low': current_price,
                        'close': current_price,
                        'volume': 0,
                        'is_complete': False
                    }
                    last_complete_timeframe = current_timeframe
                else:
                    # Update current candle
                    if current_candle is not None:
                        current_candle['high'] = max(current_candle['high'], current_price)
                        current_candle['low'] = min(current_candle['low'], current_price)
                        current_candle['close'] = current_price
                        current_candle['volume'] += 1
                    
                    # STEP 2: Monitor breakout on EVERY price update (intra-candle)
                    if alert_candle is not None and not position_taken:
                        monitor_entry_on_price(current_price, current_time)
                
                # Display status
                status_str = f"Price: {current_price:.2f}"
                if alert_candle:
                    status_str += f" | Alert: {alert_candle['type']} @ {alert_candle['timestamp'].strftime('%H:%M:%S')}"
                    status_str += f" | Break Level: {alert_candle['high']:.2f}"
                if current_position:
                    status_str += f" | Position: {current_position} @ {entry_price:.2f}"
                status_str += f" | Balance: ₹{current_balance:,.2f}"
                status_str += f" | Active: {len(active_trades)}"
                
                if PAPER_TRADING:
                    status_str += " | [PAPER MODE]"
                
                sys.stdout.write(f"\r{status_str}")
                sys.stdout.flush()
                
        elif isinstance(message, str):
            # Handle string messages
            if "pong" in message:
                pass  # Heartbeat response
            else:
                print(f"\n📨 Message: {message}")
                
    except Exception as e:
        print(f"\n❌ Error in message processing: {str(e)}")
        traceback.print_exc()

