        position_taken = True
        breakout_triggered = True
        
        # Calculate SL and Target for LONG position using percentage-based approach
        # Stop Loss: Entry - 2%
        sl_price = entry_price * (1 - SL_PERCENT)
        # Target: Entry + 2%
        target_price = entry_price * (1 + TARGET_PERCENT)
        
