        for i, trade in enumerate(closed_trades, 1):
            print(f"   Trade {i}: {trade['type']} | Entry: ₹{trade['entry_price']:.2f} | Exit: ₹{trade.get('exit_price', 0):.2f} | P&L: ₹{trade.get('PnL', 0):+,.2f}")
    
    if active_trades_list:
        print(f"\n⚠️  Active Trades: {len(active_trades_list)}")
        for i, trade in enumerate(active_trades_list, 1):
            print(f"   Trade {i}: {trade['type']} @ ₹{trade['entry_price']:.2f}")
            print(f"      Entry: ₹{trade['entry_price']:.2f} | SL: ₹{trade['sl_price']:.2f} | Target: ₹{trade['target_price']:.2f}")
    
    # Calculate statistics
    total_trades = len(closed_trades)
    winning_trades = len([t for t in closed_trades if t.get('PnL', 0) > 0])
    
    if total_trades > 0:
        win_rate = (winning_trades / total_trades) * 100
        total_pnl = sum([t.get('PnL', 0) for t in closed_trades])
        avg_pnl = total_pnl / total_trades if total_trades > 0 else 0
        
        print(f"\n📊 Trade Statistics:")
        print(f"   Total Trades: {total_trades}")
        print(f"   Winning Trades: {winning_trades}")
        print(f"   Losing Trades: {total_trades - winning_trades}")
        print(f"   Win Rate: {win_rate:.1f}%")
        print(f"   Total P&L: ₹{total_pnl:+,.2f}")
        print(f"   Average P&L per Trade: ₹{avg_pnl:+,.2f}")
    
    # Save results to file
    save_live_results()

def save_live_results():
    """Save live trading results to CSV"""
    timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    
    # Create results directory if not exists
    results_dir = "live_trading_results"
    if not os.path.exists(results_dir):
        os.makedirs(results_dir)
    
    # Add paper trading suffix to filename
    mode_suffix = "PAPER" if PAPER_TRADING else "REAL"
    
    # Save closed trades
    closed_trades = [t for t in active_trades if t.get('status') == 'CLOSED']
    if closed_trades:
        trades_df = pd.DataFrame(closed_trades)
        trades_df.to_csv(os.path.join(results_dir, f"live_trades_LONG_ONLY_{mode_suffix}_{timestamp}.csv"), index=False)
        print(f"\n💾 Trades saved to: {results_dir}/live_trades_LONG_ONLY_{mode_suffix}_{timestamp}.csv")
    
    # Save summary
    total_pnl = sum([t.get('PnL', 0) for t in closed_trades])
    
    summary = {
        'Trading_Mode': 'PAPER_TRADING' if PAPER_TRADING else 'REAL_TRADING',
        'Strategy': 'LONG_ONLY_BULLISH_FLYING_CANDLE',
        'SL_Percent': f'{SL_PERCENT*100}%',
        'Target_Percent': f'{TARGET_PERCENT*100}%',
        'Risk_Reward_Ratio': '1:1',
        'Initial_Capital': INITIAL_CAPITAL,
        'Final_Balance': current_balance,
        'Total_PnL': current_balance - INITIAL_CAPITAL,
        'Total_PnL_From_Closed_Trades': total_pnl,
        'Return_Percentage': (current_balance - INITIAL_CAPITAL) / INITIAL_CAPITAL * 100,
        'Active_Trades': len([t for t in active_trades if t.get('status') == 'ACTIVE']),
        'Closed_Trades': len(closed_trades),
        'Winning_Trades': len([t for t in closed_trades if t.get('PnL', 0) > 0]),
        'Losing_Trades': len([t for t in closed_trades if t.get('PnL', 0) < 0]),
        'Instrument_Symbol': INSTRUMENT_KEY,
        'Lot_Size': BASE_LOT_SIZE,
        'Timestamp': datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')
    }
    
    summary_df = pd.DataFrame([summary])
    summary_df.to_csv(os.path.join(results_dir, f"live_summary_LONG_ONLY_{mode_suffix}_{timestamp}.csv"), index=False)
    print(f"💾 Summary saved to: {results_dir}/live_summary_LONG_ONLY_{mode_suffix}_{timestamp}.csv")

