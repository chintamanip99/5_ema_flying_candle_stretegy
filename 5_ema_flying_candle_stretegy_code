    Check if current price breaks the alert candle's HIGH
    Rule: When current price > alert candle's HIGH, take long position immediately
    """
    global alert_candle, position_taken, current_position, entry_price, active_trades, breakout_triggered
    
    if alert_candle is None or position_taken:
        return False
    
    # Check if current price has broken the alert candle's high
    if current_price > alert_candle['high']:
        # Prevent multiple entries on same breakout
        if breakout_triggered:
            return False
        
        print(f"\n🎯 BREAKOUT DETECTED!")
        print(f"   Alert Candle High: {alert_candle['high']:.2f}")
        print(f"   Current Price: {current_price:.2f}")
        print(f"   Breakout confirmed! Entering LONG position immediately...")
        
        # ✅ Entry at ALERT candle's HIGH (breakout level)
        entry_price = alert_candle['high']
