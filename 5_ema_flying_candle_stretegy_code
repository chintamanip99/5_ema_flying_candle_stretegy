def start_live_trading():
    global fyers_ws, fyers_auth

    if not FYERS_ACCESS_TOKEN:
        print("❌ FYERS_ACCESS_TOKEN env variable is not set.")
        return

    # Auth is created in both modes: needed for history (paper) and orders (real)
    fyers_auth = fyersModel.FyersModel(
        client_id=FYERS_CLIENT_ID, token=FYERS_ACCESS_TOKEN,
        is_async=False, log_path="./logs",
    )

    print("\n" + "=" * 80)
    print("📊 FLYING CANDLE STRATEGY — BULLISH ONLY")
    print("🔵 PAPER TRADING" if PAPER_TRADING else "🔴 REAL TRADING")
    print("=" * 80)
    print(f"  Timeframe: {TIMEFRAME_MINUTES}-minute candles")
    print("  1) Alert: last candle GREEN, fully below EMA5 (high < EMA5)")
    print("  2) Entry: immediate next candle breaks alert HIGH → LONG")
    print("  3) SL   : alert candle LOW")
    print(f"  4) Target: entry + {RR_RATIO:g} x risk (1:{RR_RATIO:g})")
    print(f"  5) Capital ₹{INITIAL_CAPITAL:,} | Lot size {BASE_LOT_SIZE} | whole lots only")
    print("=" * 80)

    load_history()

    try:
        fyers_ws = data_ws.FyersDataSocket(
            access_token=f"{FYERS_CLIENT_ID}:{FYERS_ACCESS_TOKEN}",   # required format
            log_path="./logs",
            litemode=False,
            write_to_file=False,
            reconnect=True,
            on_connect=onopen,
            on_close=onclose,
            on_error=onerror,
            on_message=onmessage,
            reconnect_retry=10,
        )
        print("\n🔌 Connecting...")
        fyers_ws.connect()

        while True:
            time.sleep(1)
            # safety square-off even if no tick arrives
            if position is not None and now_ist().time() >= SQUARE_OFF and last_price:
                close_position(last_price, "INTRADAY_SQUARE_OFF", now_ist())
            if now_ist().time() >= SESSION_END and position is None:
                print("\n🔔 Session ended.")
                break

    except KeyboardInterrupt:
        print("\n\n⏹️  Stopped by user")
    except Exception as e:
        print(f"\n❌ WS setup failed: {e}")
        traceback.print_exc()
    finally:
        display_results()
        if fyers_ws:
            try:
                fyers_ws.close_connection()
            except Exception:
                pass


