# ================= TIMESTAMP HELPER FUNCTIONS =================
def timestamp_to_datetime(timestamp_str):
    """Convert timestamp string to datetime object"""
    if not timestamp_str:
        return None
    try:
        timestamp_int = int(timestamp_str)
        return datetime.datetime.fromtimestamp(timestamp_int)
    except (ValueError, TypeError):
        return None

def convert_to_ist(utc_datetime):
    """Convert UTC datetime to IST (UTC+5:30)"""
    if utc_datetime is None:
        return None
    ist_offset = timedelta(hours=5, minutes=30)
    return utc_datetime + ist_offset

def is_within_market_hours_ist(timestamp_ist):
    """Check if given IST timestamp is within market hours"""
    if timestamp_ist is None:
        return False
    
    market_open = datetime.time(MARKET_OPEN_HOUR, MARKET_OPEN_MINUTE)
    market_close = datetime.time(MARKET_CLOSE_HOUR, MARKET_CLOSE_MINUTE)
    time_only = timestamp_ist.time()
    
    return market_open <= time_only <= market_close

# ================= POSITION SIZING =================
def calculate_position_size(entry_price):
    """Calculate number of lots possible with full capital"""
    capital_per_lot = entry_price * BASE_LOT_SIZE
    
    if capital_per_lot > 0:
        max_lots = math.floor(INITIAL_CAPITAL / capital_per_lot)
        
        # Ensure at least 1 lot if possible
        if max_lots == 0 and INITIAL_CAPITAL >= capital_per_lot:
            max_lots = 1
        
        return max_lots
    
    return 0

