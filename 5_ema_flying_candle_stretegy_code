          f"({(current_balance - INITIAL_CAPITAL) / INITIAL_CAPITAL * 100:+.2f}%)")

    for i, t in enumerate(closed_trades, 1):
        print(f"  {i}. entry ₹{t['entry_price']:.2f} exit ₹{t['exit_price']:.2f} "
              f"→ ₹{t['PnL']:+,.2f} ({t['exit_reason']})")

    if position:
        print(f"⚠️  OPEN position still active: entry ₹{position['entry_price']:.2f} "
              f"SL ₹{position['sl_price']:.2f} TP ₹{position['target_price']:.2f}")

    if closed_trades:
        wins = sum(1 for t in closed_trades if t["PnL"] > 0)
        losses = sum(1 for t in closed_trades if t["PnL"] < 0)
        print(f"Trades: {len(closed_trades)} | Wins: {wins} | Losses: {losses} | "
              f"Win rate: {wins / len(closed_trades) * 100:.1f}%")
    save_results()


def save_results():
    ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    out = "live_trading_results"
    os.makedirs(out, exist_ok=True)
    mode = "PAPER" if PAPER_TRADING else "REAL"

    if closed_trades:
        path = os.path.join(out, f"trades_{mode}_{ts}.csv")
        pd.DataFrame(closed_trades).to_csv(path, index=False)
        print(f"💾 Trades saved: {path}")

    summary = {
        "Mode": mode,
        "Strategy": "BULLISH_ONLY_FLYING_CANDLE",
        "Timeframe": f"{TIMEFRAME_MINUTES}m",
        "RR_Ratio": f"1:{RR_RATIO:g}",
        "Initial_Capital": INITIAL_CAPITAL,
        "Final_Balance": current_balance,
        "Total_PnL": current_balance - INITIAL_CAPITAL,
        "Closed_Trades": len(closed_trades),
        "Instrument": INSTRUMENT_KEY,
        "Lot_Size": BASE_LOT_SIZE,
        "Timestamp": datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
    }
    path = os.path.join(out, f"summary_{mode}_{ts}.csv")
    pd.DataFrame([summary]).to_csv(path, index=False)
    print(f"💾 Summary saved: {path}")


