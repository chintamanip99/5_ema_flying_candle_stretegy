# ================= PATTERN DETECTION (BULLISH ONLY) =================
def check_pattern_on_candle(candle):
    """
    Check if a completed candle forms a BULLISH pattern (FLYING CANDLE)
    Rule: Green candle completely BELOW EMA5 (high < EMA5) - high not touching EMA5
    """
    global alert_candle, completed_candles
    
    # Need enough history for EMA calculation
    if len(completed_candles) < 10:
        return False
    
    # Calculate EMA5 from completed candles (excluding the current candle)
    closes = [c['close'] for c in list(completed_candles)[-11:-1]]
    if len(closes) < 10:
        return False
        
    df_temp = pd.DataFrame({'Close': closes})
    ema_5 = df_temp['Close'].ewm(span=5, adjust=False).mean().iloc[-1]
    
    # BULLISH PATTERN: Green candle completely BELOW EMA5 (high < EMA5)
    # High should be strictly less than EMA5 (not touching)
    if (candle['close'] > candle['open'] and  # Green candle
        candle['high'] < ema_5):  # Entire candle below EMA (high < EMA) - not touching
        
        alert_candle = {
            'type': 'BULLISH',
            'timestamp': candle['timestamp'],
            'open': candle['open'],
            'high': candle['high'],
            'low': candle['low'],
            'close': candle['close'],
            'ema_5': ema_5
        }
        
        print(f"\n\n🟢 BULLISH FLYING CANDLE DETECTED!")
        print(f"   Time: {candle['timestamp'].strftime('%Y-%m-%d %H:%M:%S')}")
        print(f"   Green Candle: O={candle['open']:.2f}, C={candle['close']:.2f}")
        print(f"   High={candle['high']:.2f}, Low={candle['low']:.2f}")
        print(f"   EMA_5: {ema_5:.2f}")
        print(f"   Distance below EMA: {ema_5 - candle['high']:.2f}")
        print(f"   ⏰ Monitoring current price for breakout above {candle['high']:.2f}")
        return True
    
    return False

def monitor_entry_on_price(current_price, current_time):
