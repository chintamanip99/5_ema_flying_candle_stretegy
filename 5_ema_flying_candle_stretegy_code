# ================= EXIT LOGIC =================
def _close_trade(trade, exit_price, exit_reason, exit_time):
    """Close trade, update balance, move to closed_trades."""
    global current_balance, closed_trades, active_trades
    global current_position, position_taken, alert_candle, alert_candle_timeframe, breakout_triggered

    print(f"\n📉 SELL {trade['shares']} @ ₹{exit_price:.2f}  ({exit_reason})")
    if PAPER_TRADING:
        print("🔵 [PAPER] Simulating exit")
    order_id = place_order(
        symbol=INSTRUMENT_KEY,
        qty=trade["shares"],
        side=-1,
        order_type="LIMIT",
        price=exit_price,
        product_type="INTRADAY",
    )
    if not order_id:
        print("❌ Exit order failed — manual intervention needed.")
        return False

    pnl = (exit_price - trade["entry_price"]) * trade["shares"]  # LONG
    current_balance += pnl

    trade["status"] = "CLOSED"
    trade["exit_price"] = exit_price
    trade["exit_reason"] = exit_reason
    trade["exit_time"] = exit_time
    trade["PnL"] = pnl
    trade["return_percentage"] = (pnl / trade["capital_used"]) * 100
    trade["exit_order_id"] = order_id

    closed_trades.append(trade)
    if trade in active_trades:
        active_trades.remove(trade)

    print(f"\n📊 TRADE CLOSED — {trade['type']}")
    print(f"   Entry ₹{trade['entry_price']:.2f} → Exit ₹{exit_price:.2f} ({exit_reason})")
    print(f"   P&L ₹{pnl:+,.2f}  ({trade['return_percentage']:+.2f}%)")
    print(f"   Balance ₹{current_balance:,.2f}")

    if trade["type"] == current_position:
        current_position = None
        position_taken = False
        alert_candle = None
        alert_candle_timeframe = None
        breakout_triggered = False
    return True


def monitor_exit_conditions(current_price, current_time, completed_candle=None):
    """
    Check exits for active LONG trades.
    Priority (conservative): if both SL and target hit in same tick/candle,
    assume SL hit first.
    """
    if not active_trades:
        return

    for trade in list(active_trades):
        if trade["status"] != "ACTIVE":
            continue

        # 1) Tick-based check (worst-case ordering: SL first)
        if current_price <= trade["sl_price"]:
            _close_trade(trade, trade["sl_price"], "SL_HIT (alert LOW)", current_time)
            continue
        if current_price >= trade["target_price"]:
            _close_trade(trade, trade["target_price"], f"TARGET_HIT ({RR_RATIO:g}R)", current_time)
            continue

        # 2) Completed-candle check (also SL first)
        if completed_candle is not None:
            if completed_candle["low"] <= trade["sl_price"]:
                _close_trade(trade, trade["sl_price"], "SL_HIT (alert LOW)", current_time)
                continue
            if completed_candle["high"] >= trade["target_price"]:
                _close_trade(trade, trade["target_price"], f"TARGET_HIT ({RR_RATIO:g}R)", current_time)
                continue


