def monitor_exit_conditions(current_price, current_time, current_candle_data):
    """Monitor active trades for exit conditions"""
    global current_balance, active_trades, current_position, position_taken, alert_candle, PAPER_TRADING
    
    for trade in active_trades[:]:
        if trade['status'] == 'ACTIVE':
            exit_price = None
            exit_reason = None
            
            # For LONG: Exit when price hits target (higher) or SL (lower)
            if trade['type'] == 'LONG':
                # Check if target hit (price went up to target)
                if current_candle_data['high'] >= trade['target_price']:
                    exit_price = trade['target_price']
                    exit_reason = 'TARGET_HIT (2%)'
                # Check if stop loss hit (price went down to SL)
                elif current_candle_data['low'] <= trade['sl_price']:
                    exit_price = trade['sl_price']
                    exit_reason = 'SL_HIT (2%)'
            
            if exit_price is not None:
                # Place SELL order to exit long position
                print(f"\n📉 Placing SELL order to exit long position @ ₹{exit_price}...")
                if PAPER_TRADING:
                    print("🔵 [PAPER TRADING MODE] - Simulating exit order")
                
                order_id = place_order(
                    symbol=INSTRUMENT_KEY,
                    qty=trade['shares'],
                    side=-1,  # -1 for SELL
                    order_type="LIMIT",
                    price=exit_price,
                    product_type="INTRADAY"
                )
                
                if order_id:
                    # Calculate PnL for LONG (Profit when exit price > entry price)
                    pnl = (exit_price - trade['entry_price']) * trade['shares']
                    
                    # Update balance (virtual for paper trading, real for actual)
                    current_balance += pnl
                    
                    trade['status'] = 'CLOSED'
                    trade['exit_price'] = exit_price
                    trade['exit_reason'] = exit_reason
                    trade['exit_time'] = current_time
                    trade['PnL'] = pnl
                    trade['return_percentage'] = (pnl / trade['capital_used']) * 100
                    trade['exit_order_id'] = order_id
                    
                    print(f"\n\n📊 TRADE CLOSED - {trade['type']}")
                    print(f"   Entry: ₹{trade['entry_price']:.2f} | Exit: ₹{exit_price:.2f} ({exit_reason})")
                    print(f"   P&L: ₹{pnl:+,.2f}")
                    print(f"   Return: {(pnl/trade['capital_used'])*100:+.2f}%")
                    print(f"   New Balance: ₹{current_balance:,.2f}")
                    
                    if PAPER_TRADING:
                        print(f"   🔵 [PAPER TRADING] - No actual money changed hands")
                    
                    # Reset position tracking
                    if trade['type'] == current_position:
                        current_position = None
                        position_taken = False
                        alert_candle = None
                        breakout_triggered = False
                    
                    # Remove closed trade
                    active_trades.remove(trade)
                else:
                    print(f"❌ Failed to place exit order. Manual intervention may be required.")
                    return False
    
    return True

