    if INSTRUMENT_KEY is None:
        print("❌ No instrument key")
        return
    try:
        fyers_ws.subscribe(symbols=[INSTRUMENT_KEY], data_type="SymbolUpdate")
        print("✅ Subscribed")
    except Exception as e:
        print(f"❌ Subscribe error: {e}")


def onmessage(message):
    global completed_candles, current_candle, last_complete_timeframe
    global alert_candle, alert_candle_timeframe, position_taken, current_position
    global entry_price, breakout_triggered

    try:
        if isinstance(message, dict):
            msg_type = message.get("type")

            if msg_type == "sub":
                print("✅ Subscription OK" if message.get("s") == "ok"
                      else f"❌ Subscription failed: {message.get('message')}")
                return

            if msg_type == "sf" or "ltp" in message:
                ltp = message.get("ltp", 0)
                if ltp == 0:
                    return

                current_price = float(ltp)
                current_time = datetime.datetime.now()
                current_timeframe = current_time.replace(second=0, microsecond=0)

                # ---------- NEW CANDLE BOUNDARY ----------
                if last_complete_timeframe is None or current_timeframe != last_complete_timeframe:

                    # Finalize previous candle
                    if current_candle is not None:
                        completed = {
                            "timestamp": current_candle["timestamp"],
                            "open": current_candle["open"],
                            "high": current_candle["high"],
                            "low": current_candle["low"],
                            "close": current_candle["close"],
                            "volume": current_candle["volume"],
                        }
                        completed_candles.append(completed)
                        print(f"\n📊 Candle closed {completed['timestamp'].strftime('%H:%M')} "
                              f"O:{completed['open']:.2f} H:{completed['high']:.2f} "
                              f"L:{completed['low']:.2f} C:{completed['close']:.2f}")

                        # STEP 1 — detect alert on the just-completed candle
                        check_pattern_on_candle(completed)

                        # exit check on completed candle (also done on ticks)
                        monitor_exit_conditions(current_price, current_time, completed)

                    # start new candle
                    current_candle = {
                        "timestamp": current_timeframe,
                        "open": current_price,
                        "high": current_price,
                        "low": current_price,
                        "close": current_price,
                        "volume": 0,
                        "is_complete": False,
                    }
                    last_complete_timeframe = current_timeframe
                    breakout_triggered = False   # new candle → breakout allowed

                else:
                    # update running candle
                    if current_candle is not None:
                        current_candle["high"] = max(current_candle["high"], current_price)
                        current_candle["low"] = min(current_candle["low"], current_price)
                        current_candle["close"] = current_price
                        current_candle["volume"] += 1

                    # STEP 2 — breakout entry (only on candle after alert)
                    if alert_candle is not None and not position_taken:
                        monitor_entry_on_price(current_price, current_time, current_timeframe)

                # ---------- EXIT CHECK ON EVERY TICK ----------
                if active_trades:
                    monitor_exit_conditions(current_price, current_time)

                # ---------- STATUS LINE ----------
                status = f"Price: {current_price:.2f}"
                if alert_candle:
                    status += f" | Alert @ {alert_candle['timestamp'].strftime('%H:%M')} H:{alert_candle['high']:.2f} L:{alert_candle['low']:.2f}"
                if current_position:
                    status += f" | {current_position} @ {entry_price:.2f}"
                status += f" | Bal ₹{current_balance:,.0f} | Active {len(active_trades)}"
                if PAPER_TRADING:
                    status += " | [PAPER]"
                sys.stdout.write(f"\r{status}")
                sys.stdout.flush()

        elif isinstance(message, str) and "pong" not in message:
            print(f"\n📨 {message}")

    except Exception as e:
        print(f"\n❌ onmessage error: {e}")
        traceback.print_exc()


def onerror(message):
