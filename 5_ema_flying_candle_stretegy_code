def now_ist():
    return datetime.datetime.now(IST).replace(tzinfo=None)


def candle_start(dt):
    """Start time of the TIMEFRAME_MINUTES candle containing dt (aligned to 9:15, like the chart)."""
    base = dt.replace(hour=SESSION_START.hour, minute=SESSION_START.minute,
                      second=0, microsecond=0)
    mins = int((dt - base).total_seconds() // 60)
    return base + datetime.timedelta(minutes=(mins // TIMEFRAME_MINUTES) * TIMEFRAME_MINUTES)


# ================= HISTORY (EMA WARM-UP) =================
def load_history():
    """Preload recent candles (TIMEFRAME_MINUTES) so EMA5 matches the chart from the start."""
    if fyers_auth is None:
        print("⚠️  No Fyers auth; EMA will warm up from live candles only.")
        return
    try:
        today = now_ist().date()
        data = {
            "symbol": INSTRUMENT_KEY,
            "resolution": str(TIMEFRAME_MINUTES),
            "date_format": "1",
            "range_from": (today - datetime.timedelta(days=5)).strftime("%Y-%m-%d"),
            "range_to": today.strftime("%Y-%m-%d"),
            "cont_flag": "1",
        }
        resp = fyers_auth.history(data=data)
        if resp.get("s") != "ok":
            print(f"⚠️  History fetch failed: {resp}")
            return
        this_candle = candle_start(now_ist())
        n = 0
        for ts, o, h, l, c, v in resp.get("candles", []):
            t = datetime.datetime.fromtimestamp(ts, IST).replace(tzinfo=None)
            if t >= this_candle:      # skip the still-forming candle
                continue
            completed_candles.append(
                {"timestamp": t, "open": o, "high": h, "low": l, "close": c, "volume": v}
            )
            n += 1
        print(f"✅ Loaded {n} historical candles for EMA warm-up")
    except Exception as e:
        print(f"⚠️  History error: {e}")


# ================= EMA =================
def compute_ema5():
    """EMA5 including the latest completed candle (same as the chart)."""
    closes = [c["close"] for c in completed_candles]
    if len(closes) < MIN_CANDLES_FOR_EMA:
        return None
    return pd.Series(closes).ewm(span=EMA_PERIOD, adjust=False).mean().iloc[-1]


# ================= POSITION SIZING =================
def calculate_lots(price):
    """Use as much of the current balance as possible (whole lots only)."""
    budget = current_balance * MAX_CAPITAL_UTILIZATION
    cost_per_lot = price * BASE_LOT_SIZE
    if cost_per_lot <= 0:
        return 0
    return math.floor(budget / cost_per_lot)


# ================= ORDER PLACEMENT =================
def place_order(symbol, qty, side, order_type="LIMIT", price=0, product_type="INTRADAY"):
    side_str = "BUY" if side == 1 else "SELL"

    if PAPER_TRADING:
        print(f"📝 [PAPER] {side_str} {qty} @ ₹{price:.2f}")
        order_id = f"PAPER_{datetime.datetime.now().strftime('%Y%m%d_%H%M%S_%f')}"
        print(f"✅ [PAPER] Order ID: {order_id}")
        return order_id

    try:
        if fyers_auth is None:
            print("❌ Fyers auth not initialized")
            return None
        order_data = {
            "symbol": symbol,
            "qty": qty,
            "type": 2 if order_type == "MARKET" else 1,   # Fyers: 1=Limit, 2=Market
            "side": side,                                  # 1=Buy, -1=Sell
            "productType": product_type,
            "limitPrice": price if order_type == "LIMIT" else 0,
            "stopPrice": 0,
            "validity": "DAY",
            "disclosedQty": 0,
            "offlineOrder": False,
        }
        print(f"📝 [REAL] Placing order: {order_data}")
        response = fyers_auth.place_order(data=order_data)
        if response.get("s") == "ok":
            print(f"✅ [REAL] Order ID: {response.get('id')}")
            return response.get("id")
        print(f"❌ [REAL] Order failed: {response}")
        return None
    except Exception as e:
        print(f"❌ place_order exception: {e}")
        traceback.print_exc()
        return None


# ================= STEP 1: ALERT DETECTION =================
def check_pattern_on_candle(candle):
    """
    BULLISH alert on the LAST completed candle:
      - GREEN (close > open)
      - lying below EMA5 and high NOT touching EMA5 (high < EMA5)
    EMA5 includes this candle's close, as on a chart.
    """
    global alert_candle

    if position is not None:
        return False

    ema5 = compute_ema5()
    if ema5 is None:
        return False

    if candle["close"] > candle["open"] and candle["high"] < ema5:
        alert_candle = {
            "timestamp": candle["timestamp"],
            "open": candle["open"],
            "high": candle["high"],
            "low": candle["low"],
            "close": candle["close"],
            "ema_5": ema5,
        }
        print("\n\n🟢 BULLISH FLYING CANDLE DETECTED")
        print(f"   Time: {candle['timestamp'].strftime('%Y-%m-%d %H:%M')}")
        print(f"   O={candle['open']:.2f} H={candle['high']:.2f} "
              f"L={candle['low']:.2f} C={candle['close']:.2f}")
        print(f"   EMA5={ema5:.2f} (gap to high = {ema5 - candle['high']:.2f})")
        print(f"   ⏰ Only the NEXT candle may break {candle['high']:.2f}")
        print(f"   🛑 SL = alert low {candle['low']:.2f}")
        return True
    return False


def alert_next_candle():
    return alert_candle["timestamp"] + datetime.timedelta(minutes=TIMEFRAME_MINUTES)


# ================= STEP 2: ENTRY =================
def monitor_entry(price, now, candle_ts):
    """LONG only if the candle immediately after the alert candle breaks the alert high."""
    global alert_candle, position, current_balance

    if alert_candle is None or position is not None:
        return
    if candle_ts != alert_next_candle():      # must be the immediate next candle
        return
    if not (ENTRY_START <= now.time() <= ENTRY_END):
        return
    if price <= alert_candle["high"]:
        return

    entry = price                      # actual fill reference = LTP at breakout
    sl = alert_candle["low"]
    risk = entry - sl
    if risk <= 0:
        print("⚠️  Invalid risk (<=0); skipping trade.")
        alert_candle = None
        return
    target = entry + RR_RATIO * risk

    lots = calculate_lots(entry)
    if lots < 1:
        print(f"⚠️  Insufficient capital for 1 lot (need ₹{entry * BASE_LOT_SIZE:,.2f}, "
              f"have ₹{current_balance:,.2f}).")
        alert_candle = None
        return
    qty = lots * BASE_LOT_SIZE
    capital_used = entry * qty

    print("\n🎯 BREAKOUT — LONG ENTRY")
    print(f"   Alert High: {alert_candle['high']:.2f} | Entry (LTP): {entry:.2f}")
    print(f"   SL: {sl:.2f} (risk {risk:.2f}) | Target: {target:.2f} (1:{RR_RATIO:g})")
    print(f"   Lots: {lots} | Qty: {qty} | Capital: ₹{capital_used:,.2f} "
          f"({capital_used / current_balance * 100:.1f}% of balance)")
    print(f"   Max risk ₹{risk * qty:,.2f} | Max reward ₹{RR_RATIO * risk * qty:,.2f}")

    order_id = place_order(INSTRUMENT_KEY, qty, 1, ORDER_TYPE, entry, PRODUCT_TYPE)
    if not order_id:
        print("❌ Entry order failed.")
        alert_candle = None
        return

    position = {
        "type": "LONG",
        "entry_price": entry,
        "sl_price": sl,
        "target_price": target,
        "lots": lots,
        "shares": qty,
        "capital_used": capital_used,
        "entry_time": now,
        "order_id": order_id,
        "paper_trading": PAPER_TRADING,
        "alert_time": alert_candle["timestamp"],
        "alert_high": alert_candle["high"],
        "alert_low": alert_candle["low"],
        "rr_ratio": RR_RATIO,
    }
    alert_candle = None
    print("✅ LONG position created.")


# ================= EXIT =================
def close_position(exit_price, reason, now):
    global position, current_balance

    t = position
    print(f"\n📉 SELL {t['shares']} @ ₹{exit_price:.2f} ({reason})")
    order_id = place_order(INSTRUMENT_KEY, t["shares"], -1, ORDER_TYPE, exit_price, PRODUCT_TYPE)
    if not order_id:
        print("❌ Exit order failed — MANUAL INTERVENTION NEEDED.")
        return False

    pnl = (exit_price - t["entry_price"]) * t["shares"]
    current_balance += pnl
    t.update({
        "exit_price": exit_price,
        "exit_reason": reason,
        "exit_time": now,
        "PnL": pnl,
        "return_percentage": pnl / t["capital_used"] * 100,
        "exit_order_id": order_id,
    })
    closed_trades.append(t)
    position = None

    print(f"📊 TRADE CLOSED: ₹{t['entry_price']:.2f} → ₹{exit_price:.2f} | "
          f"P&L ₹{pnl:+,.2f} ({t['return_percentage']:+.2f}%) | Balance ₹{current_balance:,.2f}")
    return True


def monitor_exit(price, now):
    """Tick-based exit only (so ticks before entry can never trigger a stop). SL first."""
    if position is None:
        return
    if price <= position["sl_price"]:
        close_position(price, "SL_HIT (alert LOW)", now)
    elif price >= position["target_price"]:
        close_position(price, f"TARGET_HIT ({RR_RATIO:g}R)", now)
    elif now.time() >= SQUARE_OFF:
        close_position(price, "INTRADAY_SQUARE_OFF", now)


# ================= WEBSOCKET CALLBACKS =================
def onopen():
    print("✅ WebSocket opened")
    try:
        fyers_ws.subscribe(symbols=[INSTRUMENT_KEY], data_type="SymbolUpdate")
        print("✅ Subscribed")
    except Exception as e:
        print(f"❌ Subscribe error: {e}")


def onmessage(message):
    global current_candle, alert_candle, last_price

    try:
        if isinstance(message, dict):
            if message.get("type") == "sub":
                print("✅ Subscription OK" if message.get("s") == "ok"
                      else f"❌ Subscription failed: {message.get('message')}")
                return

            ltp = message.get("ltp", 0)
            if not ltp:
                return

            price = float(ltp)
            last_price = price
            now = now_ist()
            candle_ts = candle_start(now)

            # ---------- NEW CANDLE BOUNDARY ----------
            if current_candle is None or candle_ts != current_candle["timestamp"]:
                if current_candle is not None:
                    done = {k: current_candle[k] for k in
                            ("timestamp", "open", "high", "low", "close", "volume")}
                    completed_candles.append(done)
                    print(f"\n📊 Candle {done['timestamp'].strftime('%H:%M')} "
                          f"O:{done['open']:.2f} H:{done['high']:.2f} "
                          f"L:{done['low']:.2f} C:{done['close']:.2f}")

                    # the candle right after the alert has closed w/o breakout -> expire
                    if alert_candle is not None and alert_candle["timestamp"] < done["timestamp"]:
                        print("   ⌛ Alert expired (next candle did not break).")
                        alert_candle = None

                    check_pattern_on_candle(done)

                current_candle = {
                    "timestamp": candle_ts, "open": price, "high": price,
                    "low": price, "close": price, "volume": 0,
                }

                # a gap (no candle in the minute right after alert) also expires it
                if alert_candle is not None and candle_ts != alert_next_candle():
                    print("   ⌛ Alert expired (no immediate next candle).")
                    alert_candle = None
            else:
                current_candle["high"] = max(current_candle["high"], price)
                current_candle["low"] = min(current_candle["low"], price)
                current_candle["close"] = price
                current_candle["volume"] += 1

            # ---------- ENTRY (checked on every tick, incl. first of new candle) ----------
            monitor_entry(price, now, candle_ts)

            # ---------- EXIT ----------
            monitor_exit(price, now)

            # ---------- STATUS ----------
            status = f"{now.strftime('%H:%M:%S')} Price: {price:.2f}"
            if alert_candle:
                status += f" | Alert H:{alert_candle['high']:.2f} L:{alert_candle['low']:.2f}"
            if position:
                status += (f" | LONG @ {position['entry_price']:.2f} "
                           f"SL {position['sl_price']:.2f} TP {position['target_price']:.2f}")
            status += f" | Bal ₹{current_balance:,.0f}"
            if PAPER_TRADING:
                status += " | [PAPER]"
            sys.stdout.write(f"\r{status}   ")
            sys.stdout.flush()

        elif isinstance(message, str) and "pong" not in message:
            print(f"\n📨 {message}")

    except Exception as e:
        print(f"\n❌ onmessage error: {e}")
        traceback.print_exc()


def onerror(message):
    print(f"\n❌ WS Error: {message}")


def onclose(message):
    print(f"\n🔌 WS Closed: {message}")


