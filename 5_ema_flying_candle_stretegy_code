# ================= TIMESTAMP HELPERS =================
def timestamp_to_datetime(timestamp_str):
    if not timestamp_str:
        return None
    try:
        return datetime.datetime.fromtimestamp(int(timestamp_str))
    except (ValueError, TypeError):
        return None


def convert_to_ist(utc_datetime):
    if utc_datetime is None:
        return None
    return utc_datetime + timedelta(hours=5, minutes=30)


def is_within_market_hours_ist(timestamp_ist):
    if timestamp_ist is None:
        return False
    market_open = datetime.time(MARKET_OPEN_HOUR, MARKET_OPEN_MINUTE)
    market_close = datetime.time(MARKET_CLOSE_HOUR, MARKET_CLOSE_MINUTE)
    return market_open <= timestamp_ist.time() <= market_close


# ================= POSITION SIZING =================
def calculate_position_size(entry_price):
    capital_per_lot = entry_price * BASE_LOT_SIZE
    if capital_per_lot <= 0:
        return 0
    max_lots = math.floor(INITIAL_CAPITAL / capital_per_lot)
    if max_lots == 0 and INITIAL_CAPITAL >= capital_per_lot:
        max_lots = 1
    return max_lots


