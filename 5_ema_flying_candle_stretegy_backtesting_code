    }


# ================= MAIN BACKTEST =================
def run_backtest():
    global total_pnl, active_trade, all_trades, equity_curve, all_alerts

    print("\n" + "="*80)
    print("📊 LONG ONLY BACKTEST - BULLISH PATTERN STRATEGY")
    print("="*80)
    print(f"📅 BACKTEST DATE: {BACKTEST_DATE}")
    print(f"🔧 INSTRUMENT: {INSTRUMENT_KEY}")
    print(f"⏰ Market Hours: {MARKET_OPEN_HOUR}:{MARKET_OPEN_MINUTE:02d} to "
          f"{MARKET_CLOSE_HOUR}:{MARKET_CLOSE_MINUTE:02d} IST")
    print(f"🔵 {'PAPER TRADING' if PAPER_TRADING else 'REAL TRADING'} MODE")
    print(f"🎯 Risk:Reward = 1:{RISK_REWARD_RATIO}")
    print("="*80)

    print(f"\n📡 Fetching data for {BACKTEST_DATE}...")
    df = fetch_historical_data()
    if df is None or len(df) < 10:
        print(f"❌ Insufficient data for {BACKTEST_DATE}")
        return

    print(f"\n📈 Analyzing {len(df)} candles...")
    df['EMA_5'] = df['Close'].ewm(span=5, adjust=False).mean()

    total_pnl = 0
    active_trade = None
    all_trades = []
    all_alerts = []
    equity_curve = []
    trade_counter = 0
    pending_alert = None
    running_pnl = 0

    for i in range(len(df)):
        current_time = df.index[i]
        current_candle = {
            'index': i,
            'timestamp': current_time,
            'open': df.iloc[i]['Open'],
            'high': df.iloc[i]['High'],
            'low': df.iloc[i]['Low'],
            'close': df.iloc[i]['Close'],
        }
        ema_5 = df.iloc[i]['EMA_5']

        # -------- EXIT CHECK --------
        if active_trade is not None and active_trade['status'] == 'ACTIVE':
            should_close, pnl = check_exit_conditions(active_trade, current_candle)
            if should_close:
                running_pnl += pnl
                total_pnl = running_pnl
                active_trade['status'] = 'CLOSED'
                trade_data = build_trade_row(active_trade)
                all_trades.append(trade_data)
                save_trade_to_csv(trade_data)

                print(f"\n📊 TRADE #{active_trade['trade_id']} CLOSED - {active_trade['exit_reason']}")
                print(f"   Entry: ₹{active_trade['entry_price']:.2f} | "
                      f"SL: ₹{active_trade['sl_price']:.2f} | "
                      f"Target: ₹{active_trade['target_price']:.2f} | "
                      f"Exit: ₹{active_trade['exit_price']:.2f}")
                print(f"   P&L: ₹{active_trade['pnl']:+,.2f} "
                      f"({active_trade['return_percentage']:+.2f}%) | "
                      f"Running Total: ₹{running_pnl:+,.2f}")

                active_trade = None
                pending_alert = None

        # -------- STEP 1: DETECT ALERT CANDLE --------
        if active_trade is None and pending_alert is None:
            bullish_alert = check_bullish_pattern(current_candle, ema_5, i, current_time)
            if bullish_alert:
                pending_alert = bullish_alert

        # -------- STEP 2: BREAKOUT MUST HAPPEN ON IMMEDIATE NEXT CANDLE --------
        if pending_alert is not None and active_trade is None:
            if i == pending_alert['index'] + 1:
                if current_candle['high'] > pending_alert['high']:
                    trade_counter += 1
                    new_trade = execute_long_trade(pending_alert, current_candle, trade_counter)
                    if new_trade:
                        for alert in all_alerts:
                            if alert['Alert_Time'] == pending_alert['timestamp'].strftime('%Y-%m-%d %H:%M:%S'):
                                alert['Converted_To_Trade'] = True
                                save_alert_to_csv(alert)
                                break
                        active_trade = new_trade
                    pending_alert = None
                else:
                    # No breakout on next candle → discard stale alert
                    pending_alert = None
            elif i > pending_alert['index'] + 1:
                pending_alert = None

        # -------- EQUITY CURVE --------
        if i % 10 == 0 or i == len(df) - 1:
            equity_curve.append({
                'Candle_Index': i,
                'Timestamp': current_time.strftime('%Y-%m-%d %H:%M:%S'),
                'Running_PnL': running_pnl,
                'Active_Trade': active_trade['trade_id'] if active_trade else 'None'
            })

        if (i + 1) % 50 == 0:
            print(f"   Progress: {i+1}/{len(df)} | P&L: ₹{running_pnl:+,.2f}")

    # -------- FORCE CLOSE at end of day --------
    if active_trade is not None and active_trade['status'] == 'ACTIVE':
        print(f"\n⚠️ Market close — closing LONG at last price")
        last_close = df.iloc[-1]['Close']
        pnl = (last_close - active_trade['entry_price']) * active_trade['shares']
        running_pnl += pnl

        active_trade['status'] = 'CLOSED'
        active_trade['exit_price'] = last_close
        active_trade['exit_reason'] = 'MARKET_CLOSE'
        active_trade['exit_time'] = df.index[-1]
        active_trade['pnl'] = pnl
        active_trade['return_percentage'] = (pnl / active_trade['capital_used']) * 100

        trade_data = build_trade_row(active_trade)
        all_trades.append(trade_data)
        save_trade_to_csv(trade_data)

