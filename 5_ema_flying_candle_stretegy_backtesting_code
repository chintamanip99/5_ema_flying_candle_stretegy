# ================= BULLISH PATTERN DETECTION (LONG ONLY) =================
def check_bullish_pattern(candle, ema_5, index, timestamp):
    """
    Check for BULLISH pattern: Green candle completely BELOW EMA5 (high < EMA5)
    This is the ONLY pattern we look for in LONG ONLY strategy
    """
    if not is_within_market_hours_ist(timestamp):
        return None
    
    is_green = candle['close'] > candle['open']
    
    # High should be strictly below EMA5 (not touching)
    if is_green and candle['high'] < ema_5:
        alert_data = {
            'Alert_Index': index,
            'Alert_Time': timestamp.strftime('%Y-%m-%d %H:%M:%S'),
            'Alert_Type': 'BULLISH',
            'Open': round(candle['open'], 2),
            'High': round(candle['high'], 2),
            'Low': round(candle['low'], 2),
            'Close': round(candle['close'], 2),
            'EMA_5': round(ema_5, 2),
            'Distance_Below_EMA': round(ema_5 - candle['high'], 2),
            'Converted_To_Trade': False,
            'Timestamp': datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        }
        all_alerts.append(alert_data)
        save_alert_to_csv(alert_data)
        
        print(f"\n🟢 BULLISH ALERT at {timestamp.strftime('%H:%M:%S')}")
        print(f"   Green Candle: O={candle['open']:.2f} H={candle['high']:.2f} L={candle['low']:.2f} C={candle['close']:.2f}")
        print(f"   EMA5: {ema_5:.2f} | Distance below: {ema_5 - candle['high']:.2f}")
        
        return {
            'type': 'BULLISH',
            'index': index,
            'timestamp': timestamp,
            'open': candle['open'],
            'high': candle['high'],
            'low': candle['low'],
            'close': candle['close'],
            'ema_5': ema_5
        }
    return None

def execute_long_trade(alert_candle, current_candle, trade_index):
    """
    Execute a LONG trade using full 1 lakh capital
    FIXED: Entry at breakout price (alert candle's HIGH + small buffer)
    """
    if not is_within_market_hours_ist(current_candle['timestamp']):
        return None
    
    # ✅ FIXED: Entry price is the BREAKOUT level (alert candle's HIGH + 0.05 for buffer)
    # This ensures we actually break the high, not just touch it
    entry_price = alert_candle['high'] + 0.05
    
    # ✅ FIXED: Stop Loss is LOW of alert candle
    sl_price = alert_candle['low']
    
    # Risk points
    risk_points = abs(entry_price - sl_price)
    
    # Target: Entry + (Risk * Risk Reward Ratio)
    target_price = entry_price + (risk_points * RISK_REWARD_RATIO)
    
    # Calculate number of lots possible with 1 lakh capital
    lot_size = calculate_lots_from_capital(entry_price)
    
    if lot_size < 1:
        print(f"   ⚠️ Cannot take trade. Need ₹{entry_price * BASE_LOT_SIZE:,.2f} per lot")
        return None
    
    shares_to_trade = lot_size * BASE_LOT_SIZE
    capital_required = entry_price * shares_to_trade
    
    print(f"\n💰 POSITION SIZING (Using ₹{INITIAL_CAPITAL:,.2f} capital):")
    print(f"   Alert Candle High: ₹{alert_candle['high']:.2f}")
    print(f"   Entry Price (Breakout): ₹{entry_price:.2f}")
    print(f"   Stop Loss (Alert Low): ₹{sl_price:.2f}")
    print(f"   Target: ₹{target_price:.2f}")
    print(f"   Lots: {lot_size} | Shares: {shares_to_trade}")
    print(f"   Capital Required: ₹{capital_required:,.2f}")
    
    # Place order (paper or real)
    order_id = None
    if not PAPER_TRADING:
        order_data = {
            'symbol': INSTRUMENT_KEY,
            'quantity': shares_to_trade,
            'side': 1,  # 1 for BUY (long position)
            'price': entry_price
        }
        order_id = place_real_order(order_data)
        if not order_id:
            return None
    
    trade = {
        'trade_id': trade_index,
        'type': 'LONG',
        'entry_price': entry_price,
        'sl_price': sl_price,
        'target_price': target_price,
        'lot_size': lot_size,
        'shares': shares_to_trade,
        'capital_used': capital_required,
        'entry_time': current_candle['timestamp'],
        'risk_points': risk_points,
        'reward_points': risk_points * RISK_REWARD_RATIO,
        'status': 'ACTIVE',
        'alert_candle_time': alert_candle['timestamp'],
        'alert_candle_high': alert_candle['high'],
        'alert_candle_low': alert_candle['low'],
        'order_id': order_id,
        'instrument_symbol': INSTRUMENT_KEY
    }
    
    print(f"\n🚨 LONG POSITION ENTERED at {current_candle['timestamp'].strftime('%H:%M:%S')}")
    print(f"   Entry (Breakout): ₹{entry_price:.2f}")
    print(f"   Stop Loss (Alert Low): ₹{sl_price:.2f} (-{(entry_price-sl_price)/entry_price*100:.2f}%)")
    print(f"   Target: ₹{target_price:.2f} (+{(target_price-entry_price)/entry_price*100:.2f}%)")
    print(f"   Risk:Reward = 1:{RISK_REWARD_RATIO}")
    if order_id:
        print(f"   Order ID: {order_id}")
    
    return trade

def check_exit_conditions(trade, current_candle):
    """Check if LONG trade should be exited"""
    if not is_within_market_hours_ist(current_candle['timestamp']):
        return False, 0
    
    exit_price = None
    exit_reason = None
    
    # For LONG: Exit when price hits target (higher) or SL (lower)
    # Target hit (price went up to target)
    if current_candle['high'] >= trade['target_price']:
        exit_price = trade['target_price']
        exit_reason = 'TARGET_HIT'
    # Stop loss hit (price went down to SL)
    elif current_candle['low'] <= trade['sl_price']:
        exit_price = trade['sl_price']
        exit_reason = 'SL_HIT'
    
    if exit_price is not None:
        # Calculate PnL for LONG (Profit when exit price > entry price)
        pnl = (exit_price - trade['entry_price']) * trade['shares']
        
        # Place REAL exit order if not paper trading
        if not PAPER_TRADING and trade.get('order_id'):
            try:
                fyers = fyersModel.FyersModel(
                    client_id=FYERS_CLIENT_ID,
                    token=FYERS_ACCESS_TOKEN,
                    is_async=False,
                    log_path="./logs"
                )
                
                exit_order = {
                    "symbol": INSTRUMENT_KEY,
                    "qty": trade['shares'],
                    "type": "LIMIT",
                    "side": "SELL",  # Sell to exit long position
                    "productType": "INTRADAY",
                    "limitPrice": exit_price,
                    "stopPrice": 0,
                    "validity": "DAY",
                    "disclosedQty": 0,
                    "offlineOrder": False
                }
                
                response = fyers.place_order(exit_order)
                if response.get('s') == 'ok':
                    print(f"✅ REAL EXIT ORDER PLACED: SELL @ ₹{exit_price}")
                else:
                    print(f"⚠️ REAL EXIT ORDER FAILED: {response}")
            except Exception as e:
                print(f"⚠️ Error placing exit order: {e}")
        
        trade['status'] = 'CLOSED'
        trade['exit_price'] = exit_price
        trade['exit_reason'] = exit_reason
        trade['exit_time'] = current_candle['timestamp']
        trade['pnl'] = pnl
        trade['return_percentage'] = (pnl / trade['capital_used']) * 100
        
        return True, pnl
    
    return False, 0

