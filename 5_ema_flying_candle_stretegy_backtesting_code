            'timestamp': current_time,
            'open': df.iloc[i]['Open'],
            'high': df.iloc[i]['High'],
            'low': df.iloc[i]['Low'],
            'close': df.iloc[i]['Close'],
        }
        
        ema_5 = df.iloc[i]['EMA_5']
        
        # Check exit conditions for active LONG trade
        if active_trade is not None and active_trade['status'] == 'ACTIVE':
            should_close, pnl = check_exit_conditions(active_trade, current_candle)
            if should_close:
                running_pnl += pnl
                total_pnl = running_pnl
                active_trade['status'] = 'CLOSED'
                
                trade_data = {
                    'Trade_ID': active_trade['trade_id'],
                    'Trade_Type': active_trade['type'],
                    'Entry_Time': active_trade['entry_time'].strftime('%Y-%m-%d %H:%M:%S'),
