# ================= TIMEZONE HELPER FUNCTIONS =================
def convert_utc_to_ist(utc_datetime):
    """Convert UTC datetime to IST (UTC+5:30)"""
    if utc_datetime is None:
        return None
    ist_offset = datetime.timedelta(hours=5, minutes=30)
    return utc_datetime + ist_offset

def is_within_market_hours_ist(timestamp_ist):
    """Check if given IST timestamp is within market hours (9:30 AM to 3:00 PM IST)"""
    if timestamp_ist is None:
        return False
    
    market_open = datetime.time(MARKET_OPEN_HOUR, MARKET_OPEN_MINUTE)
    market_close = datetime.time(MARKET_CLOSE_HOUR, MARKET_CLOSE_MINUTE)
    time_only = timestamp_ist.time()
    
    return market_open <= time_only <= market_close

def filter_market_hours_only(df):
    """Strict filter - keep ONLY candles between 9:30 AM and 3:00 PM IST"""
    if df is None or len(df) == 0:
        return df
    
    df = df.copy()
    mask = df.index.map(is_within_market_hours_ist)
    df_filtered = df[mask]
    
    return df_filtered

