                    'PnL': active_trade['pnl'],
                    'Return_Percentage': active_trade['return_percentage'],
                    'Exit_Reason': active_trade['exit_reason'],
                    'Lots': active_trade['lot_size'],
                    'Shares': active_trade['shares'],
                    'Risk_Points': active_trade['risk_points'],
                    'Reward_Points': active_trade['reward_points'],
                    'Alert_Candle_High': active_trade['alert_candle_high'],
                    'Alert_Candle_Low': active_trade['alert_candle_low'],
                    'status': 'CLOSED'
                }
                all_trades.append(trade_data)
                save_trade_to_csv(trade_data)
                
                print(f"\n📊 LONG TRADE #{active_trade['trade_id']} CLOSED - {active_trade['exit_reason']}")
                print(f"   Entry: ₹{active_trade['entry_price']:.2f} | Exit: ₹{active_trade['exit_price']:.2f}")
                print(f"   P&L: ₹{active_trade['pnl']:+,.2f} ({active_trade['return_percentage']:+.2f}%)")
                print(f"   Running Total P&L: ₹{running_pnl:+,.2f}")
                
                active_trade = None
                pending_alert = None
        
        # Check for BULLISH pattern ONLY
        if active_trade is None:
            bullish_alert = check_bullish_pattern(current_candle, ema_5, i, current_time)
            if bullish_alert:
                pending_alert = bullish_alert
        
        # ✅ FIXED: Check for LONG entry on NEXT candle after alert
        # Entry when current candle's HIGH breaks alert candle's HIGH
        if pending_alert is not None and active_trade is None:
            # For LONG: Entry when current candle's HIGH breaks alert candle's HIGH
            if current_candle['high'] > pending_alert['high']:
                trade_counter += 1
                new_trade = execute_long_trade(pending_alert, current_candle, trade_counter)
                
                if new_trade:
                    # Update alert to show it converted to trade
                    for alert in all_alerts:
                        if alert['Alert_Time'] == pending_alert['timestamp'].strftime('%Y-%m-%d %H:%M:%S'):
                            alert['Converted_To_Trade'] = True
                            save_alert_to_csv(alert)
                            break
                    
                    active_trade = new_trade
                    pending_alert = None
                    
                    print(f"\n✅ LONG Trade #{trade_counter} activated. Monitoring for exit...")
        
        # Record equity curve
        if i % 10 == 0 or i == len(df) - 1:
            equity_curve.append({
                'Candle_Index': i,
                'Timestamp': current_time.strftime('%Y-%m-%d %H:%M:%S'),
                'Running_PnL': running_pnl,
                'Active_Trade': active_trade['trade_id'] if active_trade else 'None'
            })
        
        # Progress indicator
        if (i + 1) % 50 == 0:
            print(f"   Progress: {i+1}/{len(df)} candles... | P&L: ₹{running_pnl:+,.2f}")
    
    # Close any open position at market close
    if active_trade is not None and active_trade['status'] == 'ACTIVE':
        print(f"\n⚠️ Market closed - closing LONG position at last price")
        last_candle = {
            'close': df.iloc[-1]['Close']
        }
        
        pnl = (last_candle['close'] - active_trade['entry_price']) * active_trade['shares']
        running_pnl += pnl
        
        active_trade['status'] = 'CLOSED'
        active_trade['exit_price'] = last_candle['close']
        active_trade['exit_reason'] = 'MARKET_CLOSE'
        active_trade['exit_time'] = df.index[-1]
        active_trade['pnl'] = pnl
        active_trade['return_percentage'] = (pnl / active_trade['capital_used']) * 100
        
        trade_data = {
            'Trade_ID': active_trade['trade_id'],
            'Trade_Type': active_trade['type'],
            'Entry_Time': active_trade['entry_time'].strftime('%Y-%m-%d %H:%M:%S'),
            'Entry_Price': active_trade['entry_price'],
            'Stop_Loss': active_trade['sl_price'],
            'Target_Price': active_trade['target_price'],
            'Exit_Time': active_trade['exit_time'].strftime('%Y-%m-%d %H:%M:%S'),
            'Exit_Price': active_trade['exit_price'],
            'PnL': active_trade['pnl'],
            'Return_Percentage': active_trade['return_percentage'],
            'Exit_Reason': active_trade['exit_reason'],
            'Lots': active_trade['lot_size'],
            'Shares': active_trade['shares'],
            'Risk_Points': active_trade['risk_points'],
            'Reward_Points': active_trade['reward_points'],
            'Alert_Candle_High': active_trade['alert_candle_high'],
            'Alert_Candle_Low': active_trade['alert_candle_low'],
            'status': 'CLOSED'
        }
        all_trades.append(trade_data)
        save_trade_to_csv(trade_data)
        
        print(f"\n📊 LONG TRADE #{active_trade['trade_id']} CLOSED at market close")
        print(f"   P&L: ₹{pnl:+,.2f}")
    
    # Display results
    print("\n" + "="*80)
    print(f"📊 LONG ONLY BACKTEST RESULTS - {BACKTEST_DATE}")
    print("="*80)
    print(f"💰 Initial Capital per Trade: ₹{INITIAL_CAPITAL:,.2f}")
    print(f"📈 Total P&L: ₹{running_pnl:+,.2f}")
    
    if all_trades:
        print("\n📋 ALL LONG TRADES SUMMARY")
        print("="*80)
        trades_df = pd.DataFrame(all_trades)
        display_cols = ['Trade_ID', 'Trade_Type', 'Entry_Time', 'Entry_Price', 'Exit_Price', 'PnL', 'Return_Percentage', 'Exit_Reason']
        print(trades_df[display_cols].to_string(index=False))
        
        total_trades = len(all_trades)
        winning_trades = len([t for t in all_trades if t['PnL'] > 0])
        losing_trades = len([t for t in all_trades if t['PnL'] < 0])
        win_rate = (winning_trades / total_trades * 100) if total_trades > 0 else 0
        avg_return = sum([t['Return_Percentage'] for t in all_trades]) / total_trades if total_trades > 0 else 0
        
        print(f"\n📊 LONG TRADE STATISTICS:")
        print(f"   Total Long Trades: {total_trades}")
        print(f"   Winning Trades: {winning_trades}")
        print(f"   Losing Trades: {losing_trades}")
        print(f"   Win Rate: {win_rate:.1f}%")
        print(f"   Average Return per Trade: {avg_return:+.2f}%")
    
    print(f"\n📊 BULLISH ALERT STATISTICS:")
    print(f"   Total Bullish Alerts: {len(all_alerts)}")
    print(f"   Alerts that turned into Long Trades: {len([a for a in all_alerts if a.get('converted_to_trade', False)])}")
    if all_alerts:
        conversion_rate = (len([a for a in all_alerts if a.get('converted_to_trade', False)]) / len(all_alerts)) * 100
        print(f"   Alert to Trade Conversion Rate: {conversion_rate:.1f}%")
    
    save_equity_curve()
    save_session_summary()
    
    print(f"\n💾 Logs saved to: {RESULTS_DIR}")
    print(f"   📄 Long Trades: {TRADES_CSV}")
    print(f"   📄 Bullish Alerts: {ALERTS_CSV}")
    print(f"   📄 Session Summary: {SESSION_SUMMARY_CSV}")
    
    return df

