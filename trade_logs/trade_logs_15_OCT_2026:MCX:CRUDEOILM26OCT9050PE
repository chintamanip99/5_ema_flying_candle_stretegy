def save_live_results():
    timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    results_dir = "live_trading_results"
    if not os.path.exists(results_dir):
        os.makedirs(results_dir)

    mode_suffix = "PAPER" if PAPER_TRADING else "REAL"

    closed_trades = [t for t in active_trades if t.get('status') == 'CLOSED']
    if closed_trades:
        pd.DataFrame(closed_trades).to_csv(
            os.path.join(results_dir, f"trades_GREEN_BELOW_EMA5_{mode_suffix}_{timestamp}.csv"),
            index=False
        )

    summary = {
        'Trading_Mode': 'PAPER' if PAPER_TRADING else 'REAL',
        'Strategy': 'GREEN_CANDLE_BELOW_EMA5_BREAKOUT_1_3_RR',
        'EMA_Period': EMA_PERIOD,
        'Risk_Reward_Ratio': f'1:{RISK_REWARD_RATIO:.0f}',
        'Initial_Capital': INITIAL_CAPITAL,
        'Final_Balance': current_balance,
        'Total_PnL': current_balance - INITIAL_CAPITAL,
        'Return_Percentage': (current_balance - INITIAL_CAPITAL) / INITIAL_CAPITAL * 100,
        'Closed_Trades': len(closed_trades),
        'Winning_Trades': len([t for t in closed_trades if t.get('PnL', 0) > 0]),
        'Instrument': INSTRUMENT_KEY,
        'Lot_Size': BASE_LOT_SIZE,
        'Timestamp': datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')
    }
    pd.DataFrame([summary]).to_csv(
        os.path.join(results_dir, f"summary_GREEN_BELOW_EMA5_{mode_suffix}_{timestamp}.csv"),
        index=False
    )
    print(f"\n💾 Results saved to {results_dir}/")


